{
  "name": "shotshelf",
  "private": true,
  "version": "0.1.0",
  "description": "The shelf that catches every capture.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "deadcode": "knip",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "test": "npm run test:unit && playwright test",
    "gate": "npm run lint && npm run deadcode && npm run build && npm run test",
    "sidecar": "node scripts/prepare-sidecar.mjs",
    "release": "node scripts/build-release.mjs",
    "postinstall": "node scripts/prepare-sidecar.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "ffmpeg-static": "^5.3.0",
    "knip": "^6.29.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
