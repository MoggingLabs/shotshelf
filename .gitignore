# ── Secrets: never commit real credentials ───────────────────────────
.env
.env.*
!.env.example
secrets/
*.token
*.tokens
tokens.json
# Updater + code-signing key material — never in the repo
*.key
*.p12
*.pfx
*.cer
*.p8
*.har
storage-state.json
cookies.txt

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node ────────────────────────────────────────────────────────────
node_modules/
dist/
build/
npm-debug.log*
pnpm-debug.log*

# ── Data & snapshots (may contain account data) ─────────────────────
snapshots/
*.snapshot.json
recon/

# ── Build prompts ───────────────────────────────────────────────────
# `prompts/` was git-ignored under a "never shipped" rule, then tracked
# (2026-07-31) so the build prompts and RESEARCH.md survive machine moves — at
# the time, safe only because the repo was made private in the same change. On
# 2026-08-01 the owner chose to make the repo PUBLIC again to restore free CI,
# keeping prompts/ and docs/council/ tracked: they are methodology, not
# secrets, and the tracked tree was scanned for credential-shaped strings
# before the flip. The gates still forbid what must never ship — captures,
# keys, real user paths.

# ── Third-party reference repos (unlicensed; consult, don't ship) ────
reference/

# ── OS / editor ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
catalog/verification/screenshots/
export/

# ── Desktop app (Tauri/Rust + Electron) ─────────────────────────────
target/
src-tauri/target/
src-tauri/gen/
# ffmpeg sidecar: ~80 MB per platform, fetched by scripts/prepare-sidecar.mjs
src-tauri/binaries/
*.app
*.dmg
*.msi
*.exe
release/
out/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Review agents run in throwaway git worktrees under here. They are clones of
# this repository, not part of it — one round committed two of them by accident.
.claude/worktrees/

# The state atlas's screenshots — regenerated on demand, never committed.
tests/atlas/output/
tests/atlas/test-output/
