# ── Secrets: never commit real credentials ───────────────────────────
.env
.env.*
!.env.example
secrets/
*.token
*.tokens
tokens.json
# Updater + code-signing key material — never in the repo
*.key
*.p12
*.pfx
*.cer
*.p8
*.har
storage-state.json
cookies.txt

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node ────────────────────────────────────────────────────────────
node_modules/
dist/
build/
npm-debug.log*
pnpm-debug.log*

# ── Data & snapshots (may contain account data) ─────────────────────
snapshots/
*.snapshot.json
recon/

# ── Local-only build prompts (never shipped) ────────────────────────
prompts/

# ── Third-party reference repos (unlicensed; consult, don't ship) ────
reference/

# ── OS / editor ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
catalog/verification/screenshots/
export/

# ── Desktop app (Tauri/Rust + Electron) ─────────────────────────────
target/
src-tauri/target/
src-tauri/gen/
# ffmpeg sidecar: ~80 MB per platform, fetched by scripts/prepare-sidecar.mjs
src-tauri/binaries/
*.app
*.dmg
*.msi
*.exe
release/
out/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Review agents run in throwaway git worktrees under here. They are clones of
# this repository, not part of it — one round committed two of them by accident.
.claude/worktrees/
